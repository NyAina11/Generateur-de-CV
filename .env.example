# Clé API Google Gemini (https://aistudio.google.com/apikey).
# Copiez ce fichier en `.env` puis renseignez votre clé. Elle reste côté serveur :
# elle n'est jamais envoyée au navigateur.
GEMINI_API_KEY=

# Optionnel : forcer un modèle Gemini précis.
# Par défaut l'API essaie gemini-3.8-flash puis se replie sur gemini-3-flash-preview.
# GEMINI_MODEL=gemini-3.8-flash
